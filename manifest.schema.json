{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nilo Connector Protocol declaration (1.0 / 1.1 / 1.2)",
  "description": "Hub approval declaration, not a package installer manifest or an attestation of trust. The name must additionally have no leading/trailing Unicode whitespace; the server enforces that rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "protocol",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {
        "enum": [
          "channel.receive",
          "channel.send",
          "channel.stream",
          "conversation.create",
          "profile.write",
          "channel.attachments",
          "channel.metadata",
          "runtime.manage",
          "native.sessions",
          "coding.sessions",
          "coding.actions",
          "coding.approvals",
          "files.read",
          "files.write",
          "media.generate",
          "questions",
          "stickers"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "channel.receive"
          }
        },
        {
          "contains": {
            "const": "channel.send"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": {
            "properties": {
              "minor": {
                "const": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "maxItems": 5,
            "items": {
              "enum": [
                "channel.receive",
                "channel.send",
                "channel.stream",
                "conversation.create",
                "profile.write"
              ]
            }
          }
        }
      }
    }
  ]
}
